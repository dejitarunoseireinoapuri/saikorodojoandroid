<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="200dp"
    android:height="200dp"
    android:viewportWidth="1024"
    android:viewportHeight="1024">

  <!-- Shadow (fake, same thickness settings as square) -->
  <group
      android:translateX="18"
      android:translateY="18"
      android:scaleX="1.03"
      android:scaleY="1.03"
      android:pivotX="512"
      android:pivotY="512">
    <path
        android:pathData="M512,151.2L872.8,872.8L151.2,872.8Z"
        android:fillColor="#33000000"/>
  </group>

  <!-- Outer shape -->
  <path
      android:pathData="M512,151.2L872.8,872.8L151.2,872.8Z"
      android:fillColor="@color/dice_selected_outer"
      android:strokeColor="@color/dice_selected_outer"
      android:strokeWidth="24"
      android:strokeLineJoin="round"
      android:strokeLineCap="round"/>

  <!-- Inner shape for thick border effect -->
  <group
      android:scaleX="0.82"
      android:scaleY="0.82"
      android:pivotX="512"
      android:pivotY="512">
    <path
        android:pathData="M512,151.2L872.8,872.8L151.2,872.8Z"
        android:fillColor="@color/dice_selected_inner"
        android:strokeColor="@color/dice_selected_inner"
        android:strokeWidth="18"
        android:strokeLineJoin="round"
        android:strokeLineCap="round"/>
  </group>
</vector>
