    <string name="rules_card_flip_title">Flip</string>
    <string name="rules_card_flip_body">Change a die to its opposite face.</string>
    <string name="rules_card_reroll_one_title">Reroll one</string>
    <string name="rules_card_reroll_one_body">Reroll a single die.</string>
    <string name="rules_card_reroll_several_title">Reroll several</string>
    <string name="rules_card_reroll_several_body">Choose multiple dice and reroll them.</string>
    <string name="rules_card_set_value_title">Choose value</string>
    <string name="rules_card_set_value_body">Set a die to a value within the limits of its type.</string>
    <string name="rules_card_repeat_title">Repeat card</string>
    <string name="rules_card_repeat_body">Repeat the effect of the last card used.</string>
    <string name="rules_card_minigames_title">Minigames</string>
    <string name="rules_card_minigames_body">Adds 3 minigame attempts, up to a maximum of 99.</string>

    <string name="rules_minigames_title">Minigames</string>
    <string name="rules_minigames_body">Minigames are a separate mode to earn cards for the main game.
When you win a minigame you receive 2 to 3 random cards.
Also, each level completed in the main game adds 2 minigame attempts.
You can store up to 99 minigame attempts.</string>

    <string name="rules_minigame_odd_even_title">Odd or even</string>
    <string name="rules_minigame_odd_even_body">Choose even or odd before each roll.\nObjective: get 3 correct guesses within a maximum of 3 rounds.</string>

    <string name="rules_minigame_higher_lower_title">Higher or lower</string>
    <string name="rules_minigame_higher_lower_body">Guess whether the next total will be higher or lower than the previous total.\nYou win by reaching 3 correct guesses.\nYou also win if the exact same total happens in two rounds in a row.</string>

    <string name="rules_minigame_sequence_title">Sequence</string>
    <string name="rules_minigame_sequence_body">You must form a non-decreasing sequence of 3 dice, where each value is equal to or higher than the previous one.\nAfter each round you decide whether to keep or discard the shown die.\nYou have 5 rounds to complete it.</string>

    <string name="rules_minigame_blackjack_title">Blackjack</string>
    <string name="rules_minigame_blackjack_body">Goal: get close to 21 without going over.\nYou start with an initial roll and then decide whether to hit (roll an additional 10-sided die) or stand.\nIf your initial roll totals 21, you win automatically.\nThen the dealer plays and stands on 17 or more.\nIf there is a tie, the dealer wins.\nA 1 counts as 1 or 11, whichever is best.</string>
